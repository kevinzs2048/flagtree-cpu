+            model_config.use_mla
+            and attention_config.backend == AttentionBackendEnum.CUTLASS_MLA
+        )
+        from vllm.platforms import current_platform
+
+        kernel_block_alignment_size = _hybrid_attention_block_alignment(
+            use_mla=model_config.use_mla,
+            use_cutlass_mla=use_cutlass_mla,
+            is_cpu=current_platform.is_cpu(),
+        )
         if model_config.use_mla:
