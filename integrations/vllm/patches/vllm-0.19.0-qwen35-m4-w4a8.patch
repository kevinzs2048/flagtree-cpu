diff --git a/vllm/platforms/cpu.py b/vllm/platforms/cpu.py
index 7fbad3e..9f42bc1 100644
--- a/vllm/platforms/cpu.py
+++ b/vllm/platforms/cpu.py
@@ -69,6 +69,13 @@ class LogicalCPUInfo:
             return obj_dict
 
 
+def _cpu_default_block_size(block_size: int, user_specified: bool) -> int:
+    """Apply the CPU minimum/alignment without shrinking hybrid block sizes."""
+    if user_specified:
+        return block_size
+    return ((max(128, block_size) + 31) // 32) * 32
+
+
 class CpuPlatform(Platform):
     _enum = PlatformEnum.CPU
     device_name: str = "cpu"
@@ -162,8 +169,10 @@ class CpuPlatform(Platform):
 
         cache_config = vllm_config.cache_config
 
-        if not cache_config.user_specified_block_size:
-            cache_config.block_size = 128
+        cache_config.block_size = _cpu_default_block_size(
+            cache_config.block_size,
+            cache_config.user_specified_block_size,
+        )
 
         if cache_config.block_size % 32 != 0:
             logger.warning(
