             attn_page_size_1_token = MLAAttentionSpec(
                 block_size=1,
                 num_kv_heads=model_config.get_num_kv_heads(parallel_config),
@@ -215,7 +233,6 @@ class HybridAttentionMambaModelConfig(VerifyAndUpdateConfig):
                 dtype=kv_cache_dtype,
             ).page_size_bytes
         else:
-            kernel_block_alignment_size = 16
             attn_page_size_1_token = FullAttentionSpec(
                 block_size=1,
                 num_kv_heads=model_config.get_num_kv_heads(parallel_config),
diff --git a/vllm/model_executor/models/qwen3_5.py b/vllm/model_executor/models/qwen3_5.py
index 4cbe9b8..9d808e8 100644
--- a/vllm/model_executor/models/qwen3_5.py
+++ b/vllm/model_executor/models/qwen3_5.py
@@ -105,6 +105,20 @@ from .utils import (
 logger = init_logger(__name__)
 
 
+def _qwen3_5_vision_quant_config(vllm_config: VllmConfig):
+    """Do not build quantized vision layers in text-only deployments.
+
+    The tower object is still constructed because the shared multimodal model
+    interface expects it, but ``_mark_tower_model`` excludes its weights from
+    loading.  Passing the global grouped-W4 config here would reject valid
+    vision dimensions (for example K=4304 with group size 32) before that
+    exclusion can take effect.
+    """
+    if vllm_config.model_config.multimodal_config.language_model_only:
+        return None
+    return vllm_config.quant_config
+
+
 class Qwen3_5ProcessingInfo(Qwen3VLProcessingInfo):
     def get_hf_config(self):
         return self.ctx.get_hf_config(Qwen3_5Config)
@@ -585,7 +599,7 @@ class Qwen3_5ForConditionalGeneration(Qwen3VLForConditionalGeneration, IsHybrid)
         nn.Module.__init__(self)
         self.update_packed_mapping(enable_lora=vllm_config.lora_config is not None)
         config: Qwen3_5Config = vllm_config.model_config.hf_config
-        quant_config = vllm_config.quant_config
+        vision_quant_config = _qwen3_5_vision_quant_config(vllm_config)
         multimodal_config = vllm_config.model_config.multimodal_config
 
         self.config = config
@@ -598,7 +612,7 @@ class Qwen3_5ForConditionalGeneration(Qwen3VLForConditionalGeneration, IsHybrid)
             self.visual = Qwen3_VisionTransformer(
                 config.vision_config,
                 norm_eps=getattr(config, "rms_norm_eps", 1e-6),
-                quant_config=quant_config,
+                quant_config=vision_quant_config,
                 prefix=maybe_prefix(prefix, "visual"),
             )
 
@@ -809,7 +823,7 @@ class Qwen3_5MoeForConditionalGeneration(
         nn.Module.__init__(self)
         self.update_packed_mapping(enable_lora=vllm_config.lora_config is not None)
         config: Qwen3_5MoeConfig = vllm_config.model_config.hf_config
-        quant_config = vllm_config.quant_config
+        vision_quant_config = _qwen3_5_vision_quant_config(vllm_config)
         multimodal_config = vllm_config.model_config.multimodal_config
 
         self.config = config
@@ -822,7 +836,7 @@ class Qwen3_5MoeForConditionalGeneration(
             self.visual = Qwen3_VisionTransformer(
                 config.vision_config,
                 norm_eps=getattr(config, "rms_norm_eps", 1e-6),
-                quant_config=quant_config,
+                quant_config=vision_quant_config,
