diff --git a/tests/model_executor/test_cpu_unquantized_gemm_dispatch.py b/tests/model_executor/test_cpu_unquantized_gemm_dispatch.py
index 322897c..c6a941b 100644
--- a/tests/model_executor/test_cpu_unquantized_gemm_dispatch.py
+++ b/tests/model_executor/test_cpu_unquantized_gemm_dispatch.py
@@ -66,3 +66,14 @@ def test_dispatch_cpu_unquantized_gemm_zen_remove_weight(monkeypatch):
     utils.dispatch_cpu_unquantized_gemm(layer, remove_weight=True)
 
     assert layer.weight.numel() == 0
+
+
+def test_dispatch_cpu_unquantized_gemm_skips_reshaped_conv_weight():
+    layer = torch.nn.Module()
+    layer.weight = torch.nn.Parameter(torch.randn(8, 1, 4))
+    original = layer.weight
+
+    utils.dispatch_cpu_unquantized_gemm(layer, remove_weight=True)
+
+    assert layer.weight is original
+    assert not hasattr(layer, "cpu_linear")
diff --git a/tests/models/test_qwen3_5_text_only_quantization.py b/tests/models/test_qwen3_5_text_only_quantization.py
new file mode 100644
index 0000000..e3fb836
--- /dev/null
+++ b/tests/models/test_qwen3_5_text_only_quantization.py
@@ -0,0 +1,43 @@
+import inspect
+from types import SimpleNamespace
+
+from vllm.model_executor.models.qwen3_5 import (
+    Qwen3_5ForConditionalGeneration,
+    Qwen3_5MoeForConditionalGeneration,
+    _qwen3_5_vision_quant_config,
+)
+
+
+def _config(language_model_only: bool):
+    quant_config = object()
+    return (
+        SimpleNamespace(
+            quant_config=quant_config,
+            model_config=SimpleNamespace(
+                multimodal_config=SimpleNamespace(
+                    language_model_only=language_model_only
+                )
+            ),
+        ),
+        quant_config,
+    )
+
+
+def test_text_only_qwen35_does_not_quantize_vision_tower():
+    config, _ = _config(language_model_only=True)
+    assert _qwen3_5_vision_quant_config(config) is None
+
+
+def test_multimodal_qwen35_keeps_requested_vision_quantization():
+    config, quant_config = _config(language_model_only=False)
+    assert _qwen3_5_vision_quant_config(config) is quant_config
+
+
+def test_dense_and_moe_constructors_resolve_vision_quant_config():
+    for model_class in (
+        Qwen3_5ForConditionalGeneration,
+        Qwen3_5MoeForConditionalGeneration,
+    ):
+        source = inspect.getsource(model_class.__init__)
+        assert "vision_quant_config = _qwen3_5_vision_quant_config" in source
+        assert "quant_config=vision_quant_config" in source
diff --git a/tests/test_cpu_platform_config.py b/tests/test_cpu_platform_config.py
new file mode 100644
index 0000000..91d5e0f
--- /dev/null
+++ b/tests/test_cpu_platform_config.py
@@ -0,0 +1,29 @@
+from vllm.model_executor.models.config import _hybrid_attention_block_alignment
+from vllm.platforms.cpu import _cpu_default_block_size
+
+
+def test_cpu_default_block_size_uses_128_minimum():
+    assert _cpu_default_block_size(16, user_specified=False) == 128
+
+
+def test_cpu_default_block_size_preserves_hybrid_requirement():
+    assert _cpu_default_block_size(528, user_specified=False) == 544
+
+
+def test_cpu_default_block_size_preserves_user_value():
+    assert _cpu_default_block_size(32, user_specified=True) == 32
+
+
+def test_hybrid_attention_uses_native_cpu_alignment():
+    assert (
+        _hybrid_attention_block_alignment(
+            use_mla=False, use_cutlass_mla=False, is_cpu=True
+        )
+        == 32
+    )
+    assert (
+        _hybrid_attention_block_alignment(
+            use_mla=False, use_cutlass_mla=False, is_cpu=False
+        )
+        == 16
+    )
diff --git a/vllm/model_executor/layers/utils.py b/vllm/model_executor/layers/utils.py
index 4918c83..c01b82e 100644
--- a/vllm/model_executor/layers/utils.py
+++ b/vllm/model_executor/layers/utils.py
@@ -228,6 +228,13 @@ def dispatch_cpu_unquantized_gemm(
         layer.cpu_linear = torch.nn.functional.linear
         return
 
+    # Some recurrent layers reuse LinearBase only for sharded weight loading,
+    # then reshape the parameter into a convolution kernel (for example Qwen
+    # 3.5 GDN conv1d has shape [N, 1, K]). Their forward path consumes the
+    # weight directly, so there is no 2-D GEMM to dispatch or prepack.
+    if layer.weight.ndim != 2:
+        return
+
     N, K = layer.weight.size()
     dtype = layer.weight.dtype
 
diff --git a/vllm/model_executor/models/config.py b/vllm/model_executor/models/config.py
index c13ea53..839d5d4 100644
--- a/vllm/model_executor/models/config.py
+++ b/vllm/model_executor/models/config.py
@@ -18,6 +18,17 @@ if TYPE_CHECKING:
 logger = init_logger(__name__)
 
 
+def _hybrid_attention_block_alignment(
+    *, use_mla: bool, use_cutlass_mla: bool, is_cpu: bool
+) -> int:
+    if use_mla:
+        return 128 if use_cutlass_mla else 64
+    # The native CPU attention kernels require 32-token KV-cache alignment;
+    # GPU FlashAttention requires only 16.  Account for this before padding
+    # the recurrent page so hybrid cache groups remain exactly equal-sized.
+    return 32 if is_cpu else 16
+
+
 class VerifyAndUpdateConfig:
