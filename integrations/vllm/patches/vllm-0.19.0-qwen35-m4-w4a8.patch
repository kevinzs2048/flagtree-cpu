 .../test_qwen3_5_text_only_quantization.py    | 43 +++++++++++++++++++
 tests/test_cpu_platform_config.py             | 29 +++++++++++++
 vllm/model_executor/layers/utils.py           |  7 +++
 vllm/model_executor/models/config.py          | 27 +++++++++---
 vllm/model_executor/models/qwen3_5.py         | 22 ++++++++--
 vllm/platforms/cpu.py                         | 13 +++++-
 7 files changed, 141 insertions(+), 11 deletions(-)
 create mode 100644 tests/models/test_qwen3_5_text_only_quantization.py
